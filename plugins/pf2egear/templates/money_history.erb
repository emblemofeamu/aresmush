<%= textline(title) %>
<%= header_line %>
<%= divider %>
<% page_items.each do |item| %>
<% if entry?(item) %>
  <%= left(time(item),18) -%>
  <%= left(awarded_by(item),14) -%>
  <%= left(award(item),11) -%>
  <%= left(running_total(item),11) -%>
  <%= left(reason(item),24) %>
<% else %>
  <%= item %>
<% end %>
<% end %>
<%= page_footer %>
