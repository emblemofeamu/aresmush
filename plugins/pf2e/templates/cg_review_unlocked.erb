<%= header %>
<%= center("#{title_color}CG Review: #{name}", 78) %>%xn
<%= section_line("Basic Info") %>
<%= left("#{item_color}Ancestry%xn: #{ancestry}", 39) -%>
<%= left("#{item_color}Heritage%xn: #{heritage}", 39) %>
<%= left("#{item_color}Background%xn: #{background}", 39) -%>
<%= left("#{item_color}Class%xn: #{charclass}", 39) %>
<%= left("#{item_color}Specialty%xn: #{subclass}", 39) -%>
<%= left("#{item_color}Specialty Choice%xn: #{subclass_option}", 39) %>
<%= section_line("Faith Info") %>
<%= left("#{item_color}Alignment%xn: #{alignment}", 39) -%>
<%= left("#{item_color}Deity%xn: #{deity}#{is_devotee}", 39) %>
<% if deity_optional %>
<%= t('pf2e.cg_deity_optional') %>
<% end %>
<% if sanctification %>
<%= "#{item_color}Sanctification%xn: #{sanctification}" %>
<% end %>
<% if has_code %>
<%= section_line("Edicts & Anathema") %>
<%= "%xh%xcYour character choices so far include edicts and anathema.%xn" %>
<%= has_code %>
<% end %>
<% if show_sofar %>
<%= section_line("So Far...") %>
<%= left("#{item_color}HP%xn: #{ahp + chp} + #{con_mod}", 26) -%>
<%= left("#{item_color}Size%xn: #{size}", 26) -%>
<%= left("#{item_color}Speed%xn: #{speed}", 26) %>
<% if hp_incomplete %>
<%= hp_incomplete %>
<% end %>
<% end %>
<% if show_traits %>
<%= section_line("Traits") %>
<%= traits.sort.join(", ") %>
<% end %>
<% if show_boosts %>
<%= section_line("Attribute Boosts") %>
<% if has_ancestry %>
<%= "#{item_color}Ancestry Boosts%xn: #{ancestry_boosts}" %>
<% end %>
<% if has_background %>
<%= "#{item_color}Background Boosts%xn: #{bg_boosts}" %>
<% end %>
<% if has_charclass %>
<%= "#{item_color}Key Attribute Boost%xn: #{key_ability}" %>
<% end %>
<%= "#{item_color}Free Boosts%xn: #{free_boosts}" %>
<%= t('pf2e.cg_boosts_next_stage') %>
<% end %>
<% if show_skills %>
<%= section_line("Skills") %>
<%= "#{item_color}Starting Skills%xn: #{starting_skills}" %>
<% if bg_skill_choice %>
<%= "#{item_color}Background Skill Choice%xn: #{bg_skill_choice}" %>
<% end %>
<% if class_skill_choice %>
<%= "#{item_color}Class Skill Choice%xn: #{class_skill_choice}" %>
<% end %>
<%= "#{item_color}Free Skills%xn: #{free_skills}" %>
<%= t('pf2e.cg_skills_note') %>
<% end %>
<% if show_magic %>
<%= section_line("Magic") %>
<% if tradition %>
<%= "#{item_color}Tradition%xn: #{tradition}" %>
<% end %>
<% if divine_font %>
<%= "#{item_color}Divine Font%xn: #{divine_font}" %>
<% end %>
<% if innate_spells %>
<%= innate_spells %>
<% end %>
<% if spells_to_choose %>
<%= spells_to_choose %>
<% end %>
<% if magic_notes %>
<%= magic_notes %>
<% end %>
<% end %>
<% if show_other %>
<%= section_line("Other Stuff") %>
<%= "#{item_color}Special Senses and Abilities%xn: #{specials}" %>
<% if has_ancestry %>
<%= "#{item_color}Starting Languages%xn: #{languages}" %>
<% end %>
<% end %>
<% if show_message_section %>
<%= section_line("Messages") %>
<% if has_messages %>
<%= errors %>
<% end %>
<% if base_info_set %>
<%= commit_prompt %>
<% end %>
<% end %>
<%= divider %>
<%= "To view commands for this stage of chargen, see '%xchelp cg_baseinfo%xn'." %>
<%= "To reset your sheet completely, enter '%xccg/reset%xn'." %>
<%= footer %>
